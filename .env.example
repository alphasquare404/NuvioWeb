# Nuvio hosted backend — works for normal frontend-only deployments.
# See docs/environment.md before replacing these with a self-hosted backend.
NUVIO_SUPABASE_URL=https://api.nuvio.tv
NUVIO_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgxNTIxMzQ2LCJleHAiOjE5MzkyMDEzNDZ9.tmQaj682pwzehpqlgCDMnySOqiUvpgRbrE43T4VJpDI
NUVIO_SUPABASE_FALLBACK_URL=https://api-two.nuvioapp.space

# Web server.
NUVIO_PORT=4173
YOUTUBE_PROXY_URL=youtube-proxy.html

# Optional Return-to-NuvioWeb notifications. See docs/environment.md.
# PUBLIC_KEY is browser-visible; PRIVATE_KEY stays server-only and must remain secret.
# Generate keys with: npx --yes web-push@3.6.7 generate-vapid-keys
NUVIO_WEB_PUSH_PUBLIC_KEY=
NUVIO_WEB_PUSH_PRIVATE_KEY=
NUVIO_WEB_PUSH_SUBJECT=mailto:admin@example.com

# Optional built-in TMDB key (browser-public). A key set in Settings by the
# person using the app always wins; this is only the fallback for anyone who
# has not set one. Empty means every user supplies their own.
TMDB_API_KEY=

# Optional address the TV sign-in QR code points at (browser-public). Empty
# uses the address the app is being served from, which is correct unless the
# television build is served from somewhere the phone cannot reach.
TV_LOGIN_WEB_BASE_URL=

# Optional Simkl integration (browser-public).
SIMKL_CLIENT_ID=
SIMKL_APP_NAME=nuvio

# Optional Premiumize Device Code integration (browser-public).
PREMIUMIZE_CLIENT_ID=

# Optional Trakt integration. The client ID is browser-public.
TRAKT_CLIENT_ID=

# Server-only Trakt bridge values. Never expose these in browser code or logs.
# The secret is optional: Trakt no longer issues one to applications that sign
# users in, and the bridge sends it only when an older application still has it.
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Server-only MDBList bridge client ID. Each browser user authorizes their own
# MDBList account; this is the NuvioWeb application identity, never a shared
# user token. Empty keeps MDBList sign-in unavailable.
MDBLIST_CLIENT_ID=

# Advanced optional browser-public endpoint overrides. See docs/environment.md.
INTRODB_API_URL=https://api.introdb.app/
IMDB_RATINGS_API_BASE_URL=
IMDB_TAPFRAME_API_BASE_URL=
AVATAR_PUBLIC_BASE_URL=
UNIQUE_CONTRIBUTIONS_BASE_URL=
DONATIONS_BASE_URL=
DONATIONS_DONATE_URL=
SPONSOR_NAMES=

# An iCloud link to a Shortcut that opens THIS deployment, offered on iPhone as
# a one-tap way back from an external player. Leave empty unless you published
# one for your own domain: a Shortcut carries the address it opens, so another
# deployment's link would send your users to someone else's instance. Empty
# shows your users how to build it in under a minute instead.
AUTOMATION_SHORTCUT_URL=

# Relays the browser cannot do for itself: ffprobe (what a stream contains),
# ffmpeg remux (MKV into MP4), and ffmpeg audio transcode (picture copied, audio
# re-encoded). Each is browser-public and each is off until set. The app reads an
# empty value as "this deployment does not offer it" and never calls it.
# Hoster policy: server (default), client (WASM + source CORS/Range), or off.
PROBE_MODE=server
PROBE_CLIENT_CONCURRENCY=1
# Optional host-assisted addon URL resolution for public HTTPS addresses. The host receives the addon URL or provider key.
MEDIA_URL_HOST_RESOLVE_ENABLED=false
PROBE_ENDPOINT=
# off/client/server; empty preserves legacy endpoint-based selection.
REMUX_MODE=
# Client OPFS disk budget (MiB), bounded to 128..512; RAM has separate limits.
REMUX_CLIENT_CACHE_MAX_MIB=512
REMUX_ENDPOINT=
TRANSCODE_ENDPOINT=

# On/off switches, read by the server at start-up (true/false). This is the runtime
# answer: a feature that is off answers 404 {"error":"disabled"} on its own path, so a
# client gets "not offered" rather than a half-working endpoint. The switch also
# decides what the app is told, so it is the only knob you need.
#
# Defaults are deliberately unequal. Probe reads a header and answers a question: on.
# Remux and transcode copy a whole film through your connection: off until you say so.
# Following these defaults therefore means "probe only", which is the safe way to run
# this for strangers.
PROBE_ENABLED=true
REMUX_ENABLED=false
TRANSCODE_ENABLED=false
# Select where audio or video conversion runs: none, client, or server.
TRANSCODE_MODE=none

# Server-only transcode access control. Never expose these in browser code.
# Optional server executable override. Leave empty for bundled/system FFmpeg.
# In Docker this is a path inside the transcode-bridge container, not the host.
FFMPEG_PATH=
# access: open (anyone who can reach the bridge), token (a shared secret that each
# app profile is given in Settings > Playback), lan (private addresses only).
# `token` fails closed: with no token set, nothing is served.
TRANSCODE_ACCESS=token
TRANSCODE_TOKEN=
TRANSCODE_AUDIO_BITRATE=192k

# Remux budget. A remux copies a whole film through the server, so the limit that
# matters is how many run at once, not how many are asked for. 0 disables a limit.
# A server with no remux at all leaves REMUX_ENDPOINT empty and needs none of these.
REMUX_MAX_CONCURRENT=1
REMUX_PER_IP_CONCURRENT=1
# Bytes. Refused with 413 before any work starts, so nobody waits for a file that
# will not be relayed. 4 GB by default; raise only if your uplink can carry it.
REMUX_MAX_SOURCE_BYTES=4294967296
# Bytes per day across all users. 0 = no daily budget. While exhausted: 503 + Retry-After.
REMUX_DAILY_BUDGET_BYTES=0

# Transcode budget, for deployments that turn it on. A transcode is CPU-bound where a
# remux is network-bound, so the defaults are tighter: one production at a time and a
# 2 GB source ceiling.
TRANSCODE_MAX_CONCURRENT=1
TRANSCODE_PER_IP_CONCURRENT=1
TRANSCODE_MAX_SOURCE_BYTES=2147483648
TRANSCODE_DAILY_BUDGET_BYTES=0

# Probe cache. The answer (container, codec, tag) cannot change, and the key is the
# file's identity when the client can name it, so this can be long.
PROBE_TTL_MS=21600000
PROBE_MAX_ENTRIES=2000

# How long a finished output stays. A paused viewer sends nothing, so the file must
# outlive the pause: three hours by default. Anything unfinished can never be played
# and is swept on the short clock.
REMUX_TTL_MS=900000
REMUX_FINISHED_TTL_MS=10800000
TRANSCODE_TIMEOUT_MS=3600000
TRANSCODE_TTL_MS=900000
TRANSCODE_FINISHED_TTL_MS=10800000

# Abandoned work. A viewer who closes the app must not keep a relay slot busy for the
# rest of the film, and a reload must not throw the work away: a buffered relay is
# cancelled this long after the last client leaves. An HLS job has no single client, so
# it is cancelled after this long with no playlist or segment request -- long enough
# that pausing to read a message does not end the film.
RELAY_ABANDON_GRACE_MS=5000
RELAY_HLS_IDLE_MS=100000

# Bandwidth and disk. Commercial hosts meter egress, so the relays share one monthly
# allowance for bytes actually sent to clients; when it is spent, new relay work answers
# 503 with a Retry-After that points at the first day of the next month. 0 = no limit.
# Disk is separate: each bridge keeps at most this much prepared output.
RELAY_MONTHLY_EGRESS_BYTES=1099511627776
REMUX_MAX_DISK_BYTES=8589934592
TRANSCODE_MAX_DISK_BYTES=4294967296

# Probe rate limit, per caller per minute. The probe is cheap but public, and one client
# looping a list should not be able to occupy the bridge. 0 disables the limit.
PROBE_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Probe: the numbers a self-hoster actually needs
#
# The probe answers "can this file play, and how?" without touching the media. It runs
# ffprobe on the source, which downloads a few MB, so these settings are the difference
# between a quiet box and a busy one.
# ---------------------------------------------------------------------------

# How many rows one page open may probe. 0 means unlimited, which is what a deployment
# used by a few people wants; a public one sets a number so the load stays predictable.
PROBE_PAGE_LIMIT=20

# How many ffprobe runs may be in flight at once. The rest queue. 0 disables the limit.
PROBE_MAX_CONCURRENT=8

# Hard ceiling on what the probe may download per day, in bytes. 0 disables it.
# 42949672960 = 40 GB/day, roughly 1.2 TB/month at ten MB per probe.
PROBE_DAILY_BYTES=42949672960

# What one probe is charged against that budget. ffprobe does not report what it read,
# so this is the assumed cost; measured reads ranged from 2 MB to 20 MB.
PROBE_COST_BYTES=10485760

# How long an answer is reused, and how many answers are kept. A long TTL is the cheapest
# way to cut both probe load and download volume: the same file is not asked twice a day.
PROBE_TTL_MS=86400000
PROBE_MAX_ENTRIES=5000

# Requests per caller per minute. 0 disables the limit.
PROBE_RATE_LIMIT_PER_MINUTE=120
